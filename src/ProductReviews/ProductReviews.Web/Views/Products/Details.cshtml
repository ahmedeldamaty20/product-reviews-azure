@model ProductReviews.Web.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<a asp-action="Index" class="text-decoration-none">&larr; Back to products</a>

<h1 class="h3 mt-2">@Model.Name</h1>
<p class="text-muted">@Model.Description</p>

<hr />

<div class="row">
    <div class="col-md-7">
        <h2 class="h5">Reviews (@Model.Reviews.Count)</h2>

        @if (!Model.Reviews.Any())
        {
            <p class="text-muted">No reviews yet. Be the first!</p>
        }

        @foreach (var r in Model.Reviews)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <strong>@r.Author</strong>
                        <span class="text-warning">@(new string('★', r.Rating))@(new string('☆', 5 - r.Rating))</span>
                    </div>
                    <p class="mb-2">@r.Comment</p>

                    @if (!string.IsNullOrEmpty(r.ImageUrl))
                    {
                        <img src="@r.ImageUrl" alt="Review image by @r.Author"
                             class="img-fluid rounded mb-2" style="max-height:240px" loading="lazy" />
                    }

                    <small class="text-muted d-block">@r.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</small>
                </div>
            </div>
        }
    </div>

    <div class="col-md-5">
        <h2 class="h5">Write a review</h2>

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <form asp-controller="Reviews" asp-action="Create" method="post" enctype="multipart/form-data">
            <input type="hidden" name="ProductId" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label" for="Author">Your name</label>
                <input class="form-control" id="Author" name="Author" maxlength="100" required />
            </div>

            <div class="mb-3">
                <label class="form-label" for="Rating">Rating</label>
                <select class="form-select" id="Rating" name="Rating" required>
                    @for (var i = 5; i >= 1; i--)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" for="Comment">Comment</label>
                <textarea class="form-control" id="Comment" name="Comment" rows="3" maxlength="2000" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label" for="image">Image (optional, max 5 MB)</label>
                <input class="form-control" type="file" id="image" name="image" accept=".jpg,.jpeg,.png,.webp" />
            </div>

            <button type="submit" class="btn btn-primary">Submit review</button>
        </form>
    </div>
</div>
